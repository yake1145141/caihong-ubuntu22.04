#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-only
#
# Expose the tablet as a USB Ethernet adapter so the device can be reached over
# the USB-C cable without any keyboard, display input or network configuration on
# the device itself.
#
# This exists because the tablet has no serial console and may have no usable
# input device on a bare console: after a fresh flash the only way in is either a
# physical keyboard or this gadget.
#
# Why CDC-NCM and not RNDIS: Windows 11 24H2 and later no longer ship the RNDIS
# driver (rndismpx.sys is absent, the interface reports "Code 28"), and Linux's
# RNDIS function only binds on Windows when Microsoft OS descriptors are present.
# NCM is a standard CDC class that Windows matches with its inbox usbncm.inf, and
# the kernel provides CONFIG_USB_CONFIGFS_NCM=y / CONFIG_USB_F_NCM=y.
#
# Host side: usb0 is 192.168.55.1/24 and hands out 192.168.55.10-50 by DHCP; a
# static 192.168.55.2/24 on the host works just as well. Then:
#   ssh root@192.168.55.1
set -Eeuo pipefail
CDPATH=

configfs=/sys/kernel/config
gadget=$configfs/usb_gadget/caihong
host_ip=192.168.55.1
netdev=usb0
dnsmasq=/usr/sbin/dnsmasq

log()
{
	echo "caihong-usbnet: $*"
	# Mirror to the kernel log: with no serial console and possibly no input
	# device, the panel console is the only place a failure can be seen.
	echo "<3>caihong-usbnet: $*" > /dev/kmsg 2>/dev/null || true
}

# Report the exact failing command instead of failing silently under set -e.
trap 'log "FAILED (line $LINENO): $BASH_COMMAND"' ERR

# A UCSI/Type-C port may come up in host role depending on what is plugged in.
# The gadget can only bind in device role, so ask for it explicitly first.
for role in /sys/class/usb_role/*/role; do
	[ -e "$role" ] || continue
	if [ "$(cat "$role" 2>/dev/null)" != device ]; then
		echo device > "$role" 2>/dev/null || true
	fi
done

if ! mountpoint -q "$configfs"; then
	mount -t configfs none "$configfs"
fi

# Rebuild the gadget from scratch: a stale instance after a reboot or a failed
# bind refuses new function links.
if [ -e "$gadget/UDC" ]; then
	: > "$gadget/UDC" 2>/dev/null || true
fi
for link in "$gadget"/configs/c.1/*; do
	[ -L "$link" ] && rm -f "$link"
done
rmdir "$gadget"/configs/c.1/strings/0x409 2>/dev/null || true
rmdir "$gadget"/configs/c.1 2>/dev/null || true
rmdir "$gadget"/functions/ncm.usb0 2>/dev/null || true
rmdir "$gadget"/strings/0x409 2>/dev/null || true
rmdir "$gadget" 2>/dev/null || true

log "building the configfs gadget"
mkdir -p "$gadget"/strings/0x409 "$gadget"/configs/c.1/strings/0x409 \
	"$gadget"/functions/ncm.usb0

printf '0x1d6b\n' > "$gadget/idVendor"
printf '0x0104\n' > "$gadget/idProduct"
printf '0x0200\n' > "$gadget/bcdUSB"
printf '0x0100\n' > "$gadget/bcdDevice"
printf 'Caihong\n' > "$gadget/strings/0x409/manufacturer"
printf 'Caihong Ubuntu USB network\n' > "$gadget/strings/0x409/product"
serial=$(tr -d '-' < /etc/machine-id 2>/dev/null | cut -c1-16 || true)
printf '%s\n' "${serial:-caihong}" > "$gadget/strings/0x409/serialnumber"
printf 'Caihong NCM\n' > "$gadget/configs/c.1/strings/0x409/configuration"
printf '250\n' > "$gadget/configs/c.1/MaxPower"
ln -sfn "$gadget/functions/ncm.usb0" "$gadget/configs/c.1/ncm.usb0"

udc=
for _ in $(seq 1 50); do
	udc=$(ls /sys/class/udc 2>/dev/null | head -n 1 || true)
	[ -n "$udc" ] && break
	sleep 0.2
done
[ -n "$udc" ] || { log "no USB device controller is available"; exit 1; }

log "binding UDC $udc"
printf '%s\n' "$udc" > "$gadget/UDC"
log "NCM gadget bound to $udc"

# The netdev appears as soon as the NCM function is instantiated.
for _ in $(seq 1 100); do
	ip link show "$netdev" >/dev/null 2>&1 && break
	sleep 0.1
done
ip link show "$netdev" >/dev/null 2>&1 || {
	log "$netdev did not appear"
	exit 1
}

ip link set "$netdev" up
ip addr add "$host_ip/24" dev "$netdev" 2>/dev/null || true
log "$netdev is $host_ip/24; host gets 192.168.55.10-50 by DHCP"

# DHCP only: no DNS, no default route, so the host keeps its normal networking
# while still being able to reach the tablet on 192.168.55.1.
#
# The gadget must stay up even if the DHCP server cannot start (for example when
# CAP_NET_RAW is unavailable, which dnsmasq needs for its raw DHCP socket). A
# static 192.168.55.2/24 on the host is enough to reach the device, so never let a
# dnsmasq failure tear the interface down.
if [ -x "$dnsmasq" ]; then
	"$dnsmasq" --keep-in-foreground --bind-dynamic \
		--interface="$netdev" --except-interface=lo \
		--dhcp-range=192.168.55.10,192.168.55.50,255.255.255.0,12h \
		--dhcp-option=3 --dhcp-option=6 \
		--port=0 --no-resolv --no-hosts \
		--pid-file=/run/caihong-usbnet.pid ||
		log "dnsmasq exited; keeping the gadget up, use a static 192.168.55.2/24 on the host"
else
	log "dnsmasq is missing; use a static 192.168.55.2/24 on the host"
fi

# Keep the unit alive and the gadget bound, whatever happened to the DHCP server.
while :; do
	sleep 3600
done
