# SPDX-License-Identifier: GPL-2.0-only
# Ubuntu 22.04 (Jammy) port configuration for the OnePlus Pad Pro (caihong).
#
# Every value here is pinned so that a rebuild produces the same rootfs even if
# upstream moves. Bump a pin only together with a fresh verification run.

# arm64 Ubuntu packages come from ubuntu-ports; archive.ubuntu.com only serves
# the x86 architectures and would silently break a cross build.
UBUNTU_MIRROR=http://mirrors.tuna.tsinghua.edu.cn/ubuntu-ports
UBUNTU_SECURITY_MIRROR=http://mirrors.tuna.tsinghua.edu.cn/ubuntu-ports
UBUNTU_SUITE=jammy
UBUNTU_UPDATES_SUITE=jammy-updates
UBUNTU_SECURITY_SUITE=jammy-security
UBUNTU_COMPONENTS=main,universe,restricted,multiverse
UBUNTU_ARCH=arm64

# Kernel, device tree and modules. These must come from the same release: the
# kernel release string is baked into /lib/modules and into the module ABI.
KERNEL_PACKAGE_NAME=linux-caihong-7.3.0.g77f2f22ff4f9-1-aarch64.pkg.tar.zst
KERNEL_PACKAGE_SHA256=27c64884f02a0462b797a17af616e6f06d674eb379fe64751e13f8ceaf85ce9c
KERNEL_RELEASE=7.3.0-g77f2f22ff4f9
# Payload digests of the validated boot image shipped in that package.
KERNEL_IMAGE_SHA256=f5f187520e52d297f884efe290dc3a265b2da15fbaccaa9b53e0f3f33631fbf0
KERNEL_DTB_SHA256=b92da2dd6f16fffe6f7241ce2ebc7758b9b87f5b4d63e1d2b997e4cc2072f4c8

# Android boot image v2 metadata used by the Caihong boot chain.
BOOT_OS_VERSION=16.0.0
BOOT_OS_PATCH_LEVEL=2026-06
BOOT_HEADER_VERSION=2
BOOT_PAGE_SIZE=4096

# First-boot account and hostname. The password is changed by the installer
# script unless CAIHONG_KEEP_DEFAULT_PASSWORD=1 is set.
CAIHONG_HOSTNAME=caihong
CAIHONG_DEFAULT_USER=caihong
CAIHONG_DEFAULT_USER_PASSWORD=caihong
CAIHONG_DEFAULT_ROOT_PASSWORD=caihong
CAIHONG_TIMEZONE=Asia/Shanghai
CAIHONG_LOCALES="en_US.UTF-8 zh_CN.UTF-8"

# Root filesystem geometry. The logical size must stay below the smallest
# partition the documented dual-boot layout can produce.
ROOTFS_IMAGE_MIN_FREE_MIB=1536
ROOTFS_IMAGE_SLACK_PERCENT=30
ROOTFS_LABEL_DUALBOOT=linux
ROOTFS_LABEL_SINGLE=userdata

# fastboot reports the SoC platform codename, not the device codename, on this
# firmware: "fastboot getvar product" answers "pineapple" for SM8650. Accept the
# known identifiers so the installer can verify it is talking to a Caihong-class
# device instead of refusing a correct device.
CAIHONG_FASTBOOT_PRODUCTS="caihong pineapple OPD2404"